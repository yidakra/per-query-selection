[Unit]
Description=Q2E MultiVENT reproduction finisher (video + LLaMA-1B), resumes after reboot
After=network-online.target
Wants=network-online.target
# Once the reproduction is fully done, this file exists and the service stays dormant.
ConditionPathExists=!/home/ubuntu/q2e_repro/runs/REPRO_FINISH_COMPLETE

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/q2e_repro
ExecStart=/home/ubuntu/q2e_repro/runs/repro_finish_svc.sh
# Long GPU job: never time it out. Best-effort, so don't hammer-restart within a boot;
# it re-runs on the NEXT boot (if still incomplete) via the condition above.
TimeoutStartSec=infinity
Restart=no

[Install]
WantedBy=multi-user.target
